{
  "manifest_version": 2,
  "name": "Zaslon Shield & uBlock Filter Core",
  "version": "2.0.0",
  "description": "Ağ seviyesi reklam/izleyici engelleyici, ClearURLs, SponsorBlock, Parmak İzi Kalkanı ve Arka Plan Ses Oynatıcı.",
  "browser_specific_settings": {
    "gecko": {
      "id": "shield@zaslon.browser",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "proxy",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "storage",
    "nativeMessaging",
    "geckoViewAddons"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
