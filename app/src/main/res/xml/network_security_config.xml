<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Tüm ağ trafiğinde şifresiz (cleartext HTTP) protokolü kesin olarak engelle -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
